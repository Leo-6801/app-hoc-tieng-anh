# Sao chép thành .env rồi điền thông tin thật. KHÔNG đưa file .env lên Git.

SHOP_NAME=Tên cửa hàng
# Mã BIN ngân hàng (NAPAS). Ví dụ: Vietcombank 970436, MB 970422, VietinBank 970415,
# BIDV 970418, Techcombank 970407, ACB 970416. Kiểm tra lại trước khi dùng.
BANK_BIN=970436
BANK_NAME=Vietcombank
ACCOUNT_NUMBER=0123456789
ACCOUNT_NAME=NGUYEN VAN A

# Địa chỉ công khai của web (dùng để tạo link in trên hóa đơn)
PUBLIC_BASE_URL=https://pay.tencongty.vn

# Khóa cho ERP gọi API (header X-API-Key) — chuỗi ngẫu nhiên dài
ADMIN_API_KEY=thay-bang-chuoi-ngau-nhien-dai
# Đăng nhập trang quản trị /admin
ADMIN_USER=admin
ADMIN_PASSWORD=thay-bang-mat-khau-manh
# Khóa cho app Android đọc tin ngân hàng (header X-Reader-Key)
READER_SECRET=thay-bang-chuoi-ngau-nhien-khac

# Tiền tố mã nhận diện trong nội dung chuyển khoản (1–4 chữ IN HOA)
REF_PREFIX=PL
# Thời hạn mặc định (phút). 0 = không hết hạn
DEFAULT_EXPIRE_MINUTES=15
DB_PATH=webqr.db

# Báo "đã thanh toán" về ERP (để trống nếu chưa có API của ERP)
ERP_CALLBACK_URL=
ERP_CALLBACK_SECRET=

# Nút mở app ngân hàng (deeplink). Dạng ma_app:Tên hiển thị, cách nhau bởi dấu phẩy.
# Dùng dịch vụ chuyển hướng công khai dl.vietqr.io — chỉ để mở app, không xác nhận tiền.
# Mã app cần kiểm tra lại với từng ngân hàng. Để trống để tắt.
BANK_APPS=vcb:Vietcombank,mb:MB Bank,icb:VietinBank,bidv:BIDV,tcb:Techcombank,acb:ACB
DEEPLINK_BASE=https://dl.vietqr.io/pay

# Số giây hiển thị mã VietQR khi khách chọn "quét từ thiết bị khác"
VIETQR_SHOW_SECONDS=90
TIMEZONE=Asia/Ho_Chi_Minh
