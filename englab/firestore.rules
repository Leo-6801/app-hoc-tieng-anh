rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi người chỉ đọc/ghi được dữ liệu của chính mình
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Bảng xếp hạng tuần: ai đăng nhập cũng xem được, mỗi người chỉ ghi điểm của mình
    match /board/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['name','week','xpWeek','streak','total','at'])
                   && request.resource.data.xpWeek is int && request.resource.data.xpWeek <= 20000;
    }
  }
}
